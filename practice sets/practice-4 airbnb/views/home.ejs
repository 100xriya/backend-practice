<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home added</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class="justify-items-center">
    <header class="bg-slate-100 rounded-md shadow-lg shadow-slate-300  justify-items-center p-10 w-full">
        <h1 class="text-5xl font-extrabold  text-red-400">Welcome to airbnb</h1>
        <p class="text-slate-400 pt-3 font-medium">Visit your staycation dream</p>
    </header>
    <main class="text-center">
        <% if (registeredHomes.length> 0 ) {%>
            <div>
                <h1 class="p-9 font-bold text-red-400 text-2xl ">
                    Explore through options:
                </h1>
                <ul class="text-left">
                    <% registeredHomes.forEach(home=> { %>
                        <li class="bg-slate-100 rounded-md w-[40vw] p-3 m-3 shadow-md hover:shadow-lg text">
                            <span>
                                <%= home.houseName%>
                            </span>
                        </li>

                        <% }) %>
                </ul>
            </div>
            <%}%>
                <div class="w-full h-full mt-20 ">
                    <a href="/add-home" class="bg-red-400 px-8 py-3 text-white font-semibold rounded-md ">Add Home</a>
                </div>
    </main>
</body>

</html>