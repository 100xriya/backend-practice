<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking List</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>

<body class="justify-items-center">
    <header class="bg-slate-100 rounded-md shadow-lg shadow-slate-300  justify-items-center p-10 w-full">
        <h1 class="text-5xl font-extrabold  text-red-400">Bookings</h1>
    </header>
    <main class="">
        <nav
            class="bg-red-400 rounded-lg shadow-md shadow-red-500 text-white font-semibold p-4  w-[60vw] flex justify-evenly">
            <a href="/">Home</a>
            <a href="../user/favourites">Favourites</a>
        </nav>

        <% if (bookedHomes.length> 0 ) {%>
            <div id="outer-container"
                class="bg-rose-50 mt-10 p-4 w-[60vw]  grid grid-cols-3 gap-4 justify-center items-center  rounded-lg shadow-lg shadow-slate-300 ">
                <% bookedHomes.forEach(home=> { %>
                    <div
                        class="card bg-slate-100 p-5 rounded-lg hover:bg-slate-200 flex flex-col items-start  shadow-md shadow-slate-400  ">
                        <div class="rounded-lg">
                            <img src=" <%=home.image %> ">

                        </div>
                        <div id="card-text" class="">
                            <h2 class="font-extrabold text-xl capitalize text-slate-600 place-self-start">
                                <%= home.houseName%>
                            </h2>
                            <p class="text-slate-800 place-self-start">
                                <b>Rating:</b>
                                <%= home.rating%>
                            </p>
                            <p class="place-self-start">
                                <strong>Location:</strong>
                                <%= home.location%>
                            </p>
                            <p class="">
                                <strong> Cost:</strong> $<%= home.price%> / night
                            </p>

                        </div>

                        <div class="flex justify-between w-full mt-5">

                            <a href="/homes/<%= home.id %>"
                                class=" bg-emerald-400 text-white font-bold px-3 py-2 rounded-lg self-center hover:bg-emerald-600 mt-5">Details</a>


                            <form action="/user/bookings/delete-bookings/<%= home.id %>" method="post" class="">
                                <button type="submit"
                                    class="bg-red-500 text-white font-bold px-3 py-2 rounded-lg hover:bg-red-600 mt-5">Cancel
                                    Booking</button>

                            </form>
                        </div>
                    </div>

                    <% }) %>
            </div>

            <% } %>
    </main>
</body>

</html>